# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=amc-portal
DB_POOL_MAX=20

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
CORS_ORIGIN=http://localhost:3000

# ── Auth (external token service) ───────────────────────────────────────────
AUTH_SERVICE_URL=https://access.spiderworks.org/api

# ── Web push notifications (browser push) ───────────────────────────────────
# Generate a keypair with:  npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push service associates with this site. When unset, the app's
# public URL (CORS_ORIGIN) is used automatically. Can be a mailto: or https:// URL.
VAPID_SUBJECT=
